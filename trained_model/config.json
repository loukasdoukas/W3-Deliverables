{
    "train": {
        "epochs": 100,
        "batch_size": 10,
        "lr": 0.0001,
        "itr_per_epoch": 2000,
        "valid_epoch_interval": 20,
        "max_valid_batches": 200,
        "max_eval_batches": 300
    },
    "diffusion": {
        "layers": 8,
        "channels": 128,
        "nheads": 8,
        "diffusion_embedding_dim": 128,
        "beta_start": 0.0001,
        "beta_end": 0.5,
        "num_steps": 50,
        "schedule": "quad",
        "eval_num_steps": 50,
        "eta": 0.6,
        "ddim_sigma_fix": true,
        "side_dim": 161
    },
    "model": {
        "timeemb": 128,
        "featureemb": 32
    },
    "dataset": {
        "data_dir": "data",
        "photometry_dir": "data/synthetic_photometry",
        "split_seed": 1
    }
}